---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes
    .filter((note) => note.data.published)
    .map((note) => ({ params: { slug: note.id }, props: { note } }));
}

const locale = 'es' as const;
const { note } = Astro.props;
const { Content } = await render(note);

const dateFormat = new Intl.DateTimeFormat('es-MX', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout locale={locale} title={note.data.title}>
  <Nav locale={locale} />

  <main class="px-6 pt-16 pb-24 md:px-16 md:pt-24 md:pb-32">
    <article class="mx-auto max-w-[720px]">
      <p class="font-mono text-ink-low mb-6 text-xs tracking-[0.14em] uppercase">
        <time datetime={note.data.pubDate.toISOString()}>
          {dateFormat.format(note.data.pubDate)}
        </time>
        {note.data.tags.length > 0 && <span> &middot; {note.data.tags.join(' \u00b7 ')}</span>}
      </p>

      <h1 class="text-[clamp(2rem,5vw,3.25rem)] leading-[1.05] font-bold tracking-[-0.03em]">
        {note.data.title}
      </h1>

      <div class="prose mt-10">
        <Content />
      </div>
    </article>
  </main>

  <Footer locale={locale} />
</Layout>

<style>
  /* Enough typography for prose, without pulling in a plugin for it. */
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    color: var(--color-ink-mid);
    font-size: 19px;
    line-height: 1.75;
    margin: 0 0 1.4em;
  }

  .prose :global(h2),
  .prose :global(h3) {
    color: var(--color-ink);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 2.2em 0 0.6em;
  }

  .prose :global(h2) {
    font-size: 30px;
  }

  .prose :global(h3) {
    font-size: 22px;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.3em;
  }

  .prose :global(li) {
    margin-bottom: 0.5em;
  }

  .prose :global(strong) {
    color: var(--color-ink);
    font-weight: 600;
  }

  .prose :global(blockquote) {
    border-left: 2px solid var(--color-signal);
    color: var(--color-ink-mid);
    font-style: italic;
    margin: 2em 0;
    padding-left: 1.4em;
  }

  .prose :global(code) {
    background: var(--color-surface);
    border: 1px solid var(--color-hairline);
    color: var(--color-signal);
    font-family: var(--font-mono);
    font-size: 0.88em;
    padding: 0.15em 0.4em;
  }

  .prose :global(pre) {
    background: var(--color-surface);
    border: 1px solid var(--color-hairline);
    margin: 2em 0;
    overflow-x: auto;
    padding: 1.2em;
  }

  .prose :global(pre code) {
    background: none;
    border: none;
    padding: 0;
  }

  .prose :global(img) {
    height: auto;
    max-width: 100%;
  }

  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--color-hairline);
    margin: 2.6em 0;
  }
</style>
