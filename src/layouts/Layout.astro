---
import '../styles/global.css';
import { type Locale, useTranslations } from '../i18n/ui';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
}

const { locale, title, description } = Astro.props;
const t = useTranslations(locale);

const pageTitle = title ? `${title} — Fernando Corrales` : t('site.title');
const pageDescription = description ?? t('site.description');

// The same page in the other language, for hreflang and the ES/EN switch.
const path = Astro.url.pathname;
const esPath = path.replace(/^\/en(?=\/|$)/, '') || '/';
const enPath = path.startsWith('/en') ? path : `/en${path === '/' ? '' : path}`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" hreflang="es" href={new URL(esPath, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(enPath, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(esPath, Astro.site)} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <title>{pageTitle}</title>
  </head>
  <body class="bg-bg text-ink">
    <slot />
  </body>
</html>
